# NAE Evaluation System v2 — environment variables (set them in Vercel → Settings → Environment Variables)
APP_SESSION_SECRET=a-long-random-string-at-least-32-characters
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Google Drive (read-only service account, Viewer on the "NAE Evaluation System" Shared Drive). Paste the whole JSON key on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Test mode: generated test images instead of Drive files. Remove once Drive is connected.
DRIVE_MOCK=
